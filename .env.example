# Environment variables needed to connect to the LiveKit server
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent Configuration
NEXT_PUBLIC_AGENT_NAME=wealth-advisor

# External API Keys (Required)
# Groq - LLM provider (llama-3.3-70b-versatile)
GROQ_API_KEY=<your_groq_api_key>

# Deepgram - STT and TTS provider
DEEPGRAM_API_KEY=<your_deepgram_api_key>

# OpenAI (Optional - not currently used)
# OPENAI_API_KEY=<your_openai_api_key>

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
